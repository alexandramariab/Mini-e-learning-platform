@{
}
@model IEnumerable<Category>
@{
    ViewData["Title"] = "Categorii";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Categorii</h1>
    <a asp-action="Create" class="btn btn-primary">+ Adaugă categorie</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Nu există încă nicio categorie.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Nume</th>
                <th class="text-center">Cursuri</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td class="text-center">@category.Courses.Count</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">Editează</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}