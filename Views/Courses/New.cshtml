@model MiniELearning.Models.Course

@{
    ViewBag.Title = "";
}

<h2 class="text-center mt-5">Add a course</h2>

<br />

<div class="container mt-5">
    <div class="row">
        <div class="col-6 offset-3">
            <form method="post" action="/Courses/New">
                @Html.Label("Title", "Course title")
                <br />
                @Html.TextBox("Title", null, new { @class = "form-control" })
                <br /><br />

                @Html.Label("Description", "Course description")
                <br />
                @Html.TextArea("Description", null, new { @class = "form-control" })
                <br /><br />

                @Html.Label("MaxEnrollments", "Maximum Enrollments")
                <br />
                @Html.TextBox("MaxEnrollments", null, new { @class = "form-control" })
                <br /><br />

                 <label>Select the level</label>
                @Html.DropDownListFor(
                    m => m.Level,                                    
                    Html.GetEnumSelectList<MiniELearning.Models.Level>(), 
                    new { @class = "form-control" }               
                )
                <br /><br />

                <label>Select the course category</label>
                @Html.DropDownListFor(m => m.CategoryId,
                        new SelectList(Model.CategoryList, "Value", "Text"),
                        "select", new { @class = "form-select" })

                <br />

                <button class="btn btn-success" type="submit">Add Course</button>

            </form>
        </div>
    </div>
</div>
