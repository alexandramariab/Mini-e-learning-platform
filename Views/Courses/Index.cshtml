*@
@{
    ViewBag.Title = "Courses";
}

<h2 class="text-center">View Courses</h2>
<br />

@* mesajul trimis prin TempData de acțiunile New, Edit și Delete
   (citit în acțiunea Index și pus în ViewBag.Message) *@
@if (ViewBag.Message != null)
{
    <h2 class="alert alert-success p-3 rounded-3 text-center mb-5">@ViewBag.Message</h2>
}

<div class="d-flex justify-content-center gap-2">
    <a class="btn btn-outline-success" asp-controller="Courses" asp-action="New">Add course</a>
</div>

<br />

@foreach (var c in ViewBag.Courses)
{
    <div class="card">

        <div class="card-body">

            <h3 class="card-title alert-success py-3 px-3 rounded-2">@c.Title</h3>

            <div class="card-text">@c.Description</div>

            <div class="d-flex justify-content-between flex-row mt-5">

                <div><i class="bi bi-globe"></i> @c.Category.Name</div>

                <div><i class="bi bi-geo-alt"></i> @c.MaxEnrollments</div>

            </div>

        </div>

    </div>

    <br />
    <br />
}
